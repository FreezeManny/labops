# Managed by labops — do not edit by hand.
# Generated from homelab.yml web_services + settings.proxy.
#
# labops only renders and places this file. The Caddy instance itself — its
# image, the DNS provider plugin, any {env.*} vars referenced below, and
# reloads — is managed outside labops.
{% if tls_plugin %}
#
# This config needs a Caddy build carrying the DNS plugin: {{ tls_plugin }}
{% endif %}

{% if tls_lines %}
*{{ proxy_suffix }} {
	tls {
{% for line in tls_lines %}
		{{ line }}
{% endfor %}
	}

{% else %}
http://*{{ proxy_suffix }} {
{% endif %}
	# Access log to stdout (view via `docker logs caddy`). Logs every request,
	# including the 403s from the access-list matchers below — so denied clients
	# and their remote_ip are visible, not just reverse_proxy errors.
	log {
		output stdout
	}

{% for r in routes %}
	@{{ r.name }} host {{ r.host }}
	handle @{{ r.name }} {
{% if r.deny %}
		@{{ r.name }}_deny remote_ip {{ r.deny | join(" ") }}
		respond @{{ r.name }}_deny "Forbidden" 403
{% endif %}
{% if r.accept %}
		@{{ r.name }}_notallowed not remote_ip {{ r.accept | join(" ") }}
		respond @{{ r.name }}_notallowed "Forbidden" 403
{% endif %}
{% if r.insecure %}
		reverse_proxy {{ r.target }} {
			transport http {
				tls_insecure_skip_verify
			}
		}
{% else %}
		reverse_proxy {{ r.target }}
{% endif %}
	}

{% endfor %}
	# Any subdomain without a matching service.
	handle {
		respond "Unknown service" 404
	}
}
